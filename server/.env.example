# Copy to .env (or export these) — never commit real keys. The browser never sees any of this.
ANTHROPIC_API_KEY=sk-ant-...
PORT=8787
ADMIN_TOKEN=choose-a-long-random-string
# AI_ENABLED=0          # switch all AI off (presets only)
# AI_MOCK=1             # fake model for development (no key, no cost)
# AI_RATE_PER_MIN=8
# AI_DAILY_BUDGET=120
# AI_GLOBAL_DAILY=20000
# Supabase (optional; otherwise server/data/db.json is used)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
